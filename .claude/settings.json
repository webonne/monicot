{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/skills/walkthrough/scripts/*)",
      "Bash(python3 .claude/skills/walkthrough-calibrate/scripts/*)",
      "Bash(python3 ${CLAUDE_PROJECT_DIR}/.claude/skills/walkthrough/scripts/*)",
      "Bash(python3 ${CLAUDE_PROJECT_DIR}/.claude/skills/walkthrough-calibrate/scripts/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_verifier_bash.py", "timeout": 10, "statusMessage": "验证员执行边界检查" }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_ledger_write.py", "timeout": 10 },
          { "type": "command", "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_verifier_write.py", "timeout": 10 }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_agent_spawn.py", "timeout": 10 }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/budget_gate.py", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/budget_gate.py", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_guard.py", "timeout": 10 }
        ]
      }
    ]
  }
}
